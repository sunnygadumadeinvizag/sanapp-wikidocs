# IIPE Wiki Docs (sanapp-wikidocs) — local development environment
# Independent application — own database (sanapp_wikidocs_db), own OIDC client.
DATABASE_URL="postgresql://wikidocs_user:wikidocs_dev_password@localhost:5432/sanapp_wikidocs_db"

# Public URLs
SSO_BASE_URL="http://localhost:3000"
MAIN_BASE_URL="http://localhost:3001"
APP_BASE_URL="http://localhost:3002"

# OIDC client registration (must match the SSO seed)
APP_CLIENT_ID="sanapp-wikidocs"
APP_CLIENT_SECRET="wikidocs_dev_client_secret"

# Shared key presented to Main when asking about application access
# (must match Main's MAIN_API_KEY)
MAIN_API_KEY="sanapp_main_api_dev_key_5e8c"

# Secret for this application's own session cookie (HS256)
APP_SESSION_SECRET="wikidocs_session_dev_secret_9d31c0"
COOKIE_SECURE="false"

# Shared key to read the central SSO user directory (must match SSO's SSO_ADMIN_KEY)
SSO_ADMIN_KEY="sanapp_admin_dev_key_a1b2c3"
