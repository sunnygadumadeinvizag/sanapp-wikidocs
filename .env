# IIPE App1 (Academic ERP) — local development environment
DATABASE_URL="postgresql://app1_user:app1_dev_password@localhost:5432/app1_db"

# Public URLs
SSO_BASE_URL="http://localhost:3000"
MAIN_BASE_URL="http://localhost:3001"
APP_BASE_URL="http://localhost:3002"

# OIDC client registration (must match the SSO seed)
APP_CLIENT_ID="iipe-app1"
APP_CLIENT_SECRET="app1_dev_client_secret"

# Shared key presented to Main when asking about application access
# (must match Main's MAIN_API_KEY)
MAIN_API_KEY="iipe_main_api_dev_key_5e8c"

# Secret for this application's own session cookie (HS256)
APP_SESSION_SECRET="app1_session_dev_secret_c41f8a02"
COOKIE_SECURE="false"
